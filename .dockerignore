# .dockerignore - Contexto de build = raiz del repo
.git
.github
.venv
venv/
.env
.env.*
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.coverage
.vscode
.idea
.DS_Store
Thumbs.db

# Datos de runtime y secretos: nunca dentro de la imagen
*.db
*.sqlite
*.log
secretos.json
**/secretos.json
backend/guias_coodescor/data/

# Fuera del alcance de la imagen
_papelera/
tools/
docs/
android_app/
deploy/windows/
backend/tests/
backend/pytest.ini
frontend/node_modules
frontend/dist
frontend/.vite
*.md
!README.md
