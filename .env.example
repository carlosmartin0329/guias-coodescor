# Guías Coodescor - Variables de entorno
# Copia este archivo a .env (EN LA RAÍZ del repositorio) y ajusta los valores.
# El backend carga automáticamente ese .env al arrancar, sin importar la carpeta
# desde la que se ejecute. Prioridad: entorno del sistema > .env > config.json > defaults.
# Todas las claves usan el prefijo COODESCOR_ (antes el prefijo no se aplicaba y
# estas variables se ignoraban por completo).

# Entorno: development | staging | production
# OJO: "production" NO activa cookies Secure por sí solo; eso depende de servir
# por HTTPS (ver COODESCOR_SESSION_COOKIE_SECURE y COODESCOR_CORS_ORIGINS).
COODESCOR_ENVIRONMENT=development

# Red
COODESCOR_HOST=0.0.0.0
COODESCOR_PORT=8000

# Directorio de datos (opcional; por defecto %ProgramData%\Coodescor\Guias en
# Windows o ~/.local/share/coodescor/guias en Linux/macOS)
# COODESCOR_DATA_DIR=

# CORS - orígenes permitidos separados por coma (ej: https://app.midominio.com,http://localhost:5173)
# Vacío = solo mismo origen (recomendado). Con orígenes HTTPS se habilita
# SameSite=None + Secure solo si además se activa la cookie segura.
COODESCOR_CORS_ORIGINS=

# URL base canónica para los links /firma/<token> que se envían al cliente.
# Recomendado en producción (evita depender de la cabecera Host).
# COODESCOR_PUBLIC_BASE_URL=https://guias.midominio.com

# Cookies: true solo si el sitio se sirve por HTTPS. Si se deja sin definir,
# se activa automáticamente cuando environment=production y CORS usa https.
# COODESCOR_SESSION_COOKIE_SECURE=false

# Proxies de confianza para X-Forwarded-For (IPs o rangos CIDR separados por coma).
# X-Forwarded-For se recorre de derecha a izquierda: solo se acepta el primer
# salto no confiable.
COODESCOR_TRUSTED_PROXIES=127.0.0.1,::1

# Límites
COODESCOR_MAX_REQUEST_BODY=31457280
COODESCOR_MAX_ADJUNTO_SIZE=10485760

# Logging
COODESCOR_LOG_LEVEL=INFO
COODESCOR_LOG_FORMAT=json

# Rate limiting (requests por ventana)
COODESCOR_RATE_LIMIT_REQUESTS=100
COODESCOR_RATE_LIMIT_WINDOW=60

# SSL (solo si se sirve HTTPS directamente desde Python)
# COODESCOR_SSL_CERT_PATH=/etc/ssl/certs/coodescor.crt
# COODESCOR_SSL_KEY_PATH=/etc/ssl/private/coodescor.key

# --- SOLO PRUEBAS AUTOMATIZADAS (nunca en producción) -----------------------
# Permite saltar el CAPTCHA cuando la petición trae el header X-CAPTCHA-Bypass
# con este mismo valor. Si la variable está vacía o ausente, el bypass no existe.
# COODESCOR_CAPTCHA_BYPASS_KEY=
