# Configuración para exportación a Supabase
# Copiar este archivo a .env y completar los valores

# URL de tu proyecto Supabase (ej: https://abcdefghijklmnop.supabase.co)
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave API de Supabase (anon key o service_role key, desde el panel de Supabase > Settings > API)
SUPABASE_KEY=TU_CLAVE_API_AQUI

# Ruta a la base de datos SQLite local (ajustar si es necesario)
SQLITE_PATH=C:\ProgramData\Coodescor\Guias\guias.db

# Tamaño de lote para inserciones (default 100)
SUPABASE_BATCH=100
