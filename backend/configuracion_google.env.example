# Copia este archivo como configuracion_google.env y completa los valores.
# No compartas este archivo ni lo subas al repositorio.
#
# URL de la implementación de Google Apps Script (termina en /exec)
COODESCOR_CONFIRMACION_URL=https://script.google.com/macros/s/REEMPLAZAR/exec
# Debe coincidir con TOKEN_SECRET en Propiedades del script de Apps Script
COODESCOR_CONFIRMACION_TOKEN_SECRET=REEMPLAZAR_CLAVE_LARGA_1
# Debe coincidir con SYNC_SECRET en Propiedades del script de Apps Script
COODESCOR_CONFIRMACION_SYNC_SECRET=REEMPLAZAR_CLAVE_LARGA_2
# Cada cuántos segundos consulta las confirmaciones (300 = 5 minutos)
COODESCOR_CONFIRMACION_INTERVALO=300
